// ═══════════════════════════════════════════════════════════════════════════
// PIKOL — Pickleball Court Booking System
// SOURCE OF TRUTH for the database schema.
//
// Render: paste into https://dbdiagram.io
// Design: ../plans/2026-09-09-court-booking-system-design.md
// Why:    0001-booking-slot-uniqueness.md
//
// ── How to use this file ───────────────────────────────────────────────────
// Alembic migrations are written FROM this file, not the other way round.
// When the schema changes, change this file first.
//
// DBML cannot express partial indexes, functional indexes, NULLS NOT
// DISTINCT, or CHECK constraints. Rather than leave those out — which would
// make this file a half-truth — they are written as exact, copy-pasteable
// DDL in APPENDIX A at the bottom. Seed data is in APPENDIX B.
//
// Everything you need to build the database is in this one file.
//
// Tables whose definition is INCOMPLETE without Appendix A are marked ⚠️.
// ═══════════════════════════════════════════════════════════════════════════

Project pikol {
  database_type: 'PostgreSQL'
  Note: '''
  Single owner → many venues → many courts. Courts sell clock-aligned
  one-hour slots, 24/7. Customers book and pay online via Maya (mobile app);
  staff book walk-ins and collect cash. Both paths write the same tables and
  pass the same uniqueness constraint.

  CONVENTIONS
  - snake_case everywhere: column, domain object, and JSON payload agree.
  - Money is integer centavos. Never float, never numeric.
  - All timestamps are timestamptz stored UTC. Day boundaries are
    Manila-local (UTC+8, no DST) — never `col::date`, which returns the
    wrong 24 hours and misplaces the 12am-1am slot onto the previous day.
  - `id` is a generated integer PK unless stated otherwise.
  - Reference and config tables carry created_at / updated_at.
  '''
}

TableGroup identity [note: 'Who is asking, and what may they do'] {
  users
  user_groups
  user_group_members
  user_group_permissions
  permissions
  refresh_tokens
  user_tokens
}

TableGroup inventory [note: 'What is for sale, and for how much'] {
  venues
  courts
  price_rules
  favorite_venues
}

TableGroup booking [note: 'Occupancy of a court-hour'] {
  booking_groups
  booking_slots
}

TableGroup money [note: 'One checkout per Pay now; its payment attempt, refund and webhooks'] {
  checkouts
  payments
  refunds
  webhook_events
}

TableGroup config [note: 'Business rules, tunable without a deploy'] {
  parameters
}

// ═══════════════════════════ ENUMS ═══════════════════════════
// These are NATIVE PostgreSQL enum types, not varchar + CHECK. They are
// closed sets defined by a state machine, and the design leans on the
// database refusing bad data — a typo'd 'CONFIRMEND' must be impossible.
//
// The cost, and it is real: Alembic autogenerate does NOT handle enum
// changes. Adding a value is always a hand-written migration:
//     ALTER TYPE booking_status ADD VALUE 'SOMETHING';
// and every type must be declared create_type=False with an explicit
// .create(op.get_bind(), checkfirst=True), or SQLAlchemy emits it twice and
// the migration fails with "type already exists".

Enum booking_type {
  PLAYER_BOOKING [note: 'Booked online by a registered player']
  WALK_IN        [note: 'Entered by staff at the counter']
  MAINTENANCE    [note: 'A closure. Same table so ONE index blocks every collision']
}

Enum booking_status {
  PENDING   [note: 'Hold. Blocks the slot. NEVER means "held" without expires_at > now()']
  CONFIRMED
  COMPLETED [note: 'Staff, after play']
  NO_SHOW   [note: 'Staff, after play']
  CANCELLED [note: 'Releases the slot']
  EXPIRED   [note: 'Releases the slot']
  // IN_PROGRESS is NOT a value. It is derived at read time:
  //   CONFIRMED AND now() >= starts_at AND now() < starts_at + interval '1 hour'
  // Storing it would be wrong between scheduler ticks; derived is exact.
}

Enum payment_status {
  UNPAID
  PAID
  FAILED
}

Enum payment_method {
  ONLINE       [note: 'Through the payment provider. Player also pays the convenience fee. A method, not a provider name — ADR 0002']
  CASH         [note: 'Counter. No fee']
  MANUAL_GCASH [note: 'Scanned the venue QR. The provider never sees it. No fee']
}

Enum token_purpose {
  EMAIL_VERIFICATION [note: 'Player signup']
  PASSWORD_RESET
  INVITATION         [note: 'Staff. Sets first password AND verifies, in one step']
}

Enum payment_provider {
  MOCK     [note: 'Dev and tests. Posts a webhook to itself; fetch_payment returns the recorded outcome']
  MAYA     [note: 'Maya Checkout. Webhooks are unsigned — re-fetch the payment (ADR 0002)']
}

Enum payment_outcome {
  // The five statuses a customer sees (ADR 0004). Used by checkouts.status
  // (the verdict) and payments.status (what the one attempt came to).
  // Maya's own wording, e.g. PAYMENT_EXPIRED, is kept in payments.provider_status.
  PENDING    [note: 'Hold placed, waiting for Maya. NEVER means live without expires_at > now()']
  SUCCESSFUL [note: 'Maya confirmed payment and every hour is ours. Final']
  FAILED     [note: 'Maya declined it. Hold released at once. Final']
  CANCELLED  [note: 'Backed out, cancelled, or the hold ended first. Can still become SUCCESSFUL or REFUNDED']
  REFUNDED   [note: 'Paid after the hold ended and an hour was taken: voided or refunded, nothing booked. Final']
}

Enum refund_kind {
  VOID   [note: 'Same Manila day as the payment, full amount']
  REFUND [note: 'From the next day, up to 180 days']
}

Enum parameter_value_type {
  int
  decimal
  bool
  string
}

Enum group_kind {
  CUSTOMER [note: 'Exactly one, no venue. Membership IS the right to book and pay as yourself (the mobile app). Holds no permission codes']
  MASTER   [note: 'One per venue — its venue masters. Only the super admin edits it']
  STAFF    [note: 'Any number per venue. Managed by the super admin or that venue’s masters']
}

// ═══════════════════════════ IDENTITY ═══════════════════════════
// Recycled from asima (users / permissions / refresh_tokens), with email
// verification added. Fixed roles were replaced by venue-owned user groups
// in 2026-10 — see ADR 0003. There is no `roles` table.

Table user_groups [note: '⚠️ its CHECK and three partial unique indexes are in Appendix A'] {
  id                 integer      [pk, increment]
  kind               group_kind   [not null]
  venue_id           integer      [null, note: 'NULL exactly when kind = CUSTOMER (Appendix A). Fixed by the SERVER from the active venue — never read from a non-admin body']
  name               varchar(64)  [not null, note: 'Unique per venue on LOWER(name) — Appendix A']
  created_at         timestamptz  [not null, default: `now()`]
  updated_at         timestamptz  [not null, default: `now()`]
  created_by_user_id integer      [null]
  updated_by_user_id integer      [null]

  indexes {
    venue_id
  }

  Note: '''
  Every venue is created with a MASTER group ("Venue master") and a STAFF
  group ("Front desk") in the same transaction. Seeds in Appendix B.

  Permissions are evaluated PER VENUE: a request names its venue in
  X-Venue-ID and the caller holds the union of their groups AT THAT VENUE
  only. Never the union across venues — ADR 0003.

  VENUE:Manage and PARAMETER:Manage are owner-only and may never be granted
  to any group, by anyone. That rule spans a join, so the service enforces
  it, not a constraint.
  '''
}

Table user_group_permissions {
  group_id      integer [not null]
  permission_id integer [not null]

  indexes {
    (group_id, permission_id) [pk]
    permission_id
  }
  Note: 'system_admin bypasses this table entirely — see users.system_admin. A CUSTOMER group has no rows here.'
}

Table user_group_members {
  group_id         integer     [not null]
  user_id          integer     [not null]
  added_by_user_id integer     [null]
  created_at       timestamptz [not null, default: `now()`]

  indexes {
    (group_id, user_id) [pk]
    user_id
  }
  Note: '''
  One person may be in many groups, across venues, and in CUSTOMER as well
  as staff groups — the two axes are independent.
  '''
}

Table permissions {
  id          integer      [pk, increment]
  code        varchar(100) [not null, unique, note: 'RESOURCE:Action, e.g. COURT:Manage']
  resource    varchar(50)  [not null, note: 'Split out so the UI can group by resource without parsing code']
  action      varchar(30)  [not null]
  description varchar(255)
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  indexes {
    resource
  }
}

Table users [note: '⚠️ email uniqueness is in Appendix A, not on the column'] {
  id                integer      [pk, increment]
  email             varchar(255) [not null]
  password_hash     varchar(255) [null, note: 'NULL until an invited staff member sets their own — the manager never knows it. Load DEFERRED so it is never fetched by an ordinary read']
  first_name        varchar(100) [not null]
  last_name         varchar(100) [not null]
  mobile            varchar(32)
  system_admin      boolean      [not null, default: false, note: 'Unconditional bypass axis, ORTHOGONAL to group membership — asima ADR 0001. The guard short-circuits on this. Never a group']
  is_active         boolean      [not null, default: false, note: 'False until verification or invitation acceptance']
  email_verified_at timestamptz  [null]
  last_login_at     timestamptz  [null]
  created_at        timestamptz  [not null, default: `now()`]
  updated_at        timestamptz  [not null, default: `now()`]
  deleted_at        timestamptz  [null, note: 'Soft delete. A deleted user must not block email re-use — see Appendix A']

  indexes {
    is_active
  }

  Note: '''
  Who someone is lives here; what they may do lives in user_group_members.
  A customer is a member of the CUSTOMER group; staff at venue V are members
  of V's MASTER or STAFF groups; one account may be both (ADR 0003).

  ⚠️ There is deliberately NO unique constraint on the email column. Appendix
  A declares a partial functional index on LOWER(email) WHERE deleted_at IS
  NULL. A plain unique column would treat Jane@x.com and jane@x.com as
  different people, and would permanently block re-registering an address
  after a soft delete. (Recycled from asima.)

  PRIVILEGE ESCALATION — a non-owner may only place people in STAFF groups
  of the ACTIVE venue, and the server — never the request body — decides a
  new group's venue and kind. Reading either from input lets a venue master
  mint another master, or a credential at another venue that passes every
  VenueScope check while looking entirely normal in the logs.
  '''
}

Table refresh_tokens [note: 'The revocation ledger — asima ADR 0002'] {
  id         integer     [pk, increment]
  user_id    integer     [not null]
  jti        uuid        [not null, unique, note: 'The refresh token JWT id. NOT the token itself']
  expires_at timestamptz [not null]
  revoked_at timestamptz [null, note: 'NULL = active. Stamped on rotation (one row) or logout (all the user rows)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, revoked_at)
    expires_at
  }

  Note: '''
  Stores NO secret material — only the jti claim, its owner, and expiry. A
  leak of this table cannot be used to authenticate as anyone.

  Rotation: refreshing revokes the presented jti and issues a new one.
  Presenting an already-revoked jti means the token was replayed, so every
  row for that user is revoked and the session is dead. Logout revokes all.
  '''
}

Table user_tokens [note: 'Email verification, password reset, staff invitation'] {
  id         integer       [pk, increment]
  user_id    integer       [not null]
  purpose    token_purpose [not null]
  token_hash varchar(255)  [not null, unique, note: 'Hashed at rest. The raw token exists only inside the email']
  expires_at timestamptz   [not null]
  used_at    timestamptz   [null, note: 'Single use']
  created_at timestamptz   [not null, default: `now()`]

  indexes {
    (user_id, purpose)
  }
}

// ═══════════════════════════ INVENTORY ═══════════════════════════

Table venues {
  id                 integer      [pk, increment]
  name               varchar(128) [not null]
  address            text
  is_active          boolean      [not null, default: true, note: 'Operational toggle. Not a delete']
  created_at         timestamptz  [not null, default: `now()`]
  updated_at         timestamptz  [not null, default: `now()`]
  created_by_user_id integer      [null]
  updated_by_user_id integer      [null]
}

Table courts {
  id                 integer     [pk, increment]
  venue_id           integer     [not null]
  name               varchar(64) [not null]
  sort_order         integer     [not null, default: 0, note: 'Column order in the availability grid. Staff control it; without this the grid reorders on every deploy']
  is_active          boolean     [not null, default: true]
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]
  created_by_user_id integer     [null]
  updated_by_user_id integer     [null]

  indexes {
    (venue_id, sort_order)
  }

  Note: '''
  NO price column — pricing lives entirely in price_rules over the
  parameters fallback.

  NO slot_minutes column. Considered and rejected: every slot is exactly one
  hour, and a configurable length contradicts the on-the-hour CHECK (a
  90-minute court needs slots at 01:30). Variable slot length becomes a
  migration on the day a venue asks.
  '''
}

Table favorite_venues {
  user_id    integer     [not null]
  venue_id   integer     [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, venue_id) [pk]
  }
  Note: 'A customer\'s favorite venues, for the mobile app\'s Favorites tab. No web UI yet.'
}

Table price_rules [note: '⚠️ its unique index needs NULLS NOT DISTINCT — Appendix A'] {
  id                 integer     [pk, increment]
  court_id           integer     [not null]
  day_of_week        integer     [null, note: 'NULL = any day. 0=Sunday .. 6=Saturday']
  hour_of_day        integer     [null, note: 'NULL = any hour. 0..23']
  price_centavos     integer     [not null]
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]
  created_by_user_id integer     [null]
  updated_by_user_id integer     [null]

  indexes {
    court_id
  }

  Note: '''
  NULLs are WILDCARDS. This is how a court gets its own flat price without
  inserting 24 rows:

    (NULL, NULL) → flat rate, any time     (NULL, 18) → 6pm every day
    (6,    NULL) → all Saturday            (6,    18) → Saturday 6pm

  RESOLUTION, most-specific-wins:
    (day,hour) → (hour) → (day) → (NULL,NULL) → parameters.default_slot_price_centavos

  Resolve IN MEMORY, not per cell. A 6-court venue-day is 144 cells; load
  the venue rules once (tens of rows) and resolve against that set. Per-cell
  SQL is 144 round trips wearing one endpoint as a disguise.

  ⚠️ The unique index MUST be NULLS NOT DISTINCT (Appendix A). Postgres
  treats NULLs as distinct by default, so without it every wildcard row is
  trivially unique, the constraint does nothing, and two equally-specific
  rules resolve by arbitrary row order.
  '''
}

// ═══════════════════════════ BOOKING ═══════════════════════════

Table booking_groups {
  id                   integer        [pk, increment]
  reference_code       varchar(12)    [not null, unique, note: 'Human-quotable, e.g. PKL-A7X3Q. Staff on the phone cannot read out an integer id']
  court_id             integer        [not null, note: 'AUTHORITATIVE. A group is exactly ONE court']
  player_id            integer        [null, note: 'NULL for WALK_IN and MAINTENANCE']
  type                 booking_type   [not null]
  booking_status       booking_status [not null]
  payment_status       payment_status [not null, note: 'AUTHORITATIVE over payments.status']
  price_centavos       integer        [not null, note: 'Sum of slot prices. FROZEN at creation']
  fee_centavos         integer        [not null, default: 0, note: 'FROZEN at creation. Always 0 for walk-ins']
  total_centavos       integer        [not null, note: 'What was actually charged. Kept, not derived — this is the money record']
  payment_method       payment_method [null]
  checkout_id          integer        [null, note: 'Set exactly for PLAYER_BOOKING — Appendix A §15. The checkout that paid (or tried to pay) for it']
  expires_at           timestamptz    [null, note: 'Hold deadline. Set for PENDING only. Equals its checkout.expires_at']
  needs_resolution     boolean        [not null, default: false, note: 'Paid but unhousable. Feeds the admin queue']
  notes                text
  created_by_user_id   integer        [not null, note: 'The player for online, the staff member for a walk-in']
  cancelled_at         timestamptz    [null]
  cancelled_by_user_id integer        [null]
  cancellation_reason  text           [null, note: 'REQUIRED when cancelling. No refunds, so this is the whole audit trail']
  created_at           timestamptz    [not null, default: `now()`]
  updated_at           timestamptz    [not null, default: `now()`]

  indexes {
    (player_id, booking_status)  [note: 'My Bookings, and the hold cap count']
    (court_id, booking_status)
    (booking_status, expires_at) [note: 'Finding lapsed holds']
    needs_resolution             [note: 'Admin resolution queue']
    checkout_id
  }

  Note: '''
  A multi-hour session is ONE group with N slot rows — one payment, one
  cancellation unit. Booking two courts for the same hour is two groups.

    Online:  PENDING/UNPAID   → webhook → CONFIRMED/PAID
    Walk-in: CONFIRMED/UNPAID → staff   → CONFIRMED/PAID

  TWO STATUS AXES because a staff-created walk-in must block its slot BEFORE
  money changes hands. One column cannot express that without inventing
  CONFIRMED_UNPAID and then doubling every state that follows.

  needs_resolution is a FLAG, not a status. Such a booking genuinely is
  EXPIRED/PAID; inventing a status would force every state-machine guard to
  handle a value that is not a state.

  PRICE IS FROZEN. Never recompute from price_rules. The owner raising the
  6pm rate must not retroactively change what somebody already paid.

  ⚠️ THE PENDING TRAP. Hold cleanup is lazy — it happens on the write path,
  not a scheduler — so a lapsed hold on a slot nobody contests keeps its row
  indefinitely. booking_status = PENDING therefore NEVER means "currently
  holding" on its own. EVERY read must add `AND expires_at > now()`.

  Miss it on the availability query and the grid is stale for 15 minutes.
  Miss it on the hold-cap count and a player who abandoned checkout three
  times is PERMANENTLY unable to book, with nothing that ever clears it.
  '''
}

Table booking_slots [note: '⚠️ its unique index is PARTIAL — Appendix A'] {
  id               integer        [pk, increment]
  booking_group_id integer        [not null]
  court_id         integer        [not null, note: 'Mirrors the group. Duplicated because the index must live here']
  starts_at        timestamptz    [not null, note: 'Always on the hour — CHECK in Appendix A']
  price_centavos   integer        [not null, note: 'This hour resolved price, frozen']
  booking_status   booking_status [not null, note: 'Mirrors the group. Same transaction, never independently']

  indexes {
    (court_id, starts_at) [name: 'uq_court_slot_active', note: '⚠️ PARTIAL and UNIQUE — see Appendix A']
    booking_group_id
    starts_at             [note: 'Availability scans a Manila day range']
  }

  Note: '''
  One row per hour. A 6-8pm booking is two rows in one group.

  ⚠️ uq_court_slot_active IS PARTIAL. dbdiagram renders it as an ordinary
  index because DBML has no WHERE clause. Building it from the render alone
  would forbid ever rebooking a cancelled slot. Use Appendix A.

  That one predicate makes EVERY collision impossible in the database —
  online vs online, online vs walk-in, and booking vs maintenance — with no
  application locking, no SELECT FOR UPDATE, and no read-then-write race.
  The loser of a race gets an IntegrityError, which the router turns into
  409.

  NO ends_at: every slot is exactly one hour, so it is derived. A stored
  copy is drift waiting to happen.

  STATUS IS DENORMALIZED HERE because a Postgres index predicate cannot
  reference another table, and uniqueness must be enforced on the row it
  protects. booking_groups stays authoritative, and a SINGLE repository
  method owns every status write, touching both tables in one transaction.
  Any other code path that writes this column corrupts availability itself.
  This warrants a dedicated test, not a comment.
  '''
}

// ═══════════════════════════ MONEY ═══════════════════════════

Table checkouts [note: '⚠️ its money CHECK is in Appendix A'] {
  id              integer         [pk, increment]
  reference_code  varchar(12)     [not null, unique, note: 'Sent to Maya as requestReferenceNumber; quoted to the customer']
  customer_id     integer         [not null]
  venue_id        integer         [not null, note: 'ONE venue per payment (ADR 0004 decision 2)']
  status          payment_outcome [not null, note: 'THE verdict the customer sees. One writer: CheckoutRepository.set_status']
  price_centavos  integer         [not null, note: 'Sum of its groups. FROZEN']
  fee_centavos    integer         [not null, note: 'Convenience fee on the subtotal, FROZEN; allocated across its groups']
  total_centavos  integer         [not null, note: 'price + fee — what Maya is asked for']
  expires_at      timestamptz     [not null, note: 'The hold deadline, kept after the hold ends as its record']
  created_at      timestamptz     [not null, default: `now()`]
  updated_at      timestamptz     [not null, default: `now()`]

  indexes {
    (customer_id, status) [note: 'My bookings, and the hold cap count']
    (status, expires_at)
  }

  Note: '''
  ONE per "Pay now". The checkout is the unit of PAYMENT; the booking group
  stays the unit of OCCUPANCY (one court, ADR 0001). A checkout covering
  two courts, or two runs of hours on one court, owns several groups, all
  sharing its expires_at, so they are held and released together.

  ⚠️ THE PENDING TRAP APPLIES HERE TOO. A lapsed hold keeps status PENDING
  until something writes it (cleanup is lazy). PENDING never means live
  without `expires_at > now()` — the hold cap counts only live ones, and a
  lapsed PENDING reads CANCELLED.

  One payment attempt per checkout: a failed or cancelled attempt has
  already released its hours, and the customer starts again (ADR 0004
  decision 10).
  '''
}

Table payments [note: '⚠️ one open attempt per checkout — partial unique index in Appendix A'] {
  id                   integer          [pk, increment]
  checkout_id          integer          [not null]
  provider             payment_provider [not null]
  provider_checkout_id varchar(128)     [not null, unique]
  provider_payment_id  varchar(128)     [null, note: 'For Maya, equals provider_checkout_id — the checkoutId IS the paymentId']
  checkout_url         text             [not null, note: 'Where the customer pays. Reused, never re-created: a second session could also be paid']
  amount_centavos      integer          [not null]
  status               payment_outcome  [not null, note: 'What this attempt came to. checkouts.status holds the verdict']
  provider_status      varchar(32)      [null, note: 'Maya own wording, e.g. PAYMENT_EXPIRED']
  raw_payload          jsonb            [null, note: '⚠️ PII — purged after webhook_payload_retention_days. NEVER logged']
  created_at           timestamptz      [not null, default: `now()`]
  updated_at           timestamptz      [not null, default: `now()`]

  indexes {
    checkout_id
    created_at [note: 'Retention purge scans by age']
  }
  Note: 'One row per provider ATTEMPT — today exactly one per checkout, opened by "Continue to Maya".'
}

Table refunds {
  id                 integer      [pk, increment]
  payment_id         integer      [not null, unique, note: 'A payment is undone at most once, always in full']
  kind               refund_kind  [not null]
  amount_centavos    integer      [not null]
  provider_reference varchar(128) [not null, note: 'Maya reference for the void or refund']
  created_at         timestamptz  [not null, default: `now()`]

  Note: 'The simple refund flow (ADR 0004 decision 7): a payment that landed after its hold ended, when any of its hours had been taken.'
}

Table webhook_events {
  id                integer          [pk, increment]
  provider          payment_provider [not null]
  provider_event_id varchar(128)     [not null, unique, note: 'THE idempotency key. Insert first; the unique violation IS the already-processed check. Maya events have no ID: "{payment_id}:{payment_status}"']
  payload           jsonb            [not null, note: '⚠️ PII — purged after webhook_payload_retention_days. NEVER logged']
  processed_at      timestamptz      [null]
  received_at       timestamptz      [not null, default: `now()`]

  indexes {
    received_at [note: 'Retention purge scans by age']
  }

  Note: '''
  IDEMPOTENCY COMES FROM THE SCHEMA, not from code. The handler INSERTS
  FIRST; a unique violation means "already processed" and it returns 200
  without acting. There is no if-already-handled branch to get wrong and no
  race between two concurrent redeliveries.

  Maya retries, and retries must be free.

  The payload is UNTRUSTED. Maya does not sign webhooks: the handler acts on
  the payment re-fetched from Maya, never on this body (ADR 0002).
  '''
}

// ═══════════════════════════ CONFIG ═══════════════════════════

Table parameters {
  key                varchar(64)          [pk]
  value              text                 [not null, note: 'Text; Pydantic coerces and validates on load, so a typo raises instead of silently becoming zero']
  value_type         parameter_value_type [not null, note: 'For rendering the admin input. NOT used for coercion']
  description        text                 [not null]
  updated_at         timestamptz          [not null, default: `now()`]
  updated_by_user_id integer              [null, note: 'Audit trail on numbers that move money']

  Note: '''
  Business rules, tunable without a deploy. Distinct from environment
  config (secrets, connection strings), which is read once at boot.

  Admin-only writes. Ten seeded keys — see APPENDIX B.

  min_lead_minutes may be 0 (book 1-2 PM at 12:58 PM), so a hold may run a
  few minutes into the hour it holds. An hour whose start has passed can
  never be held or re-acquired (ADR 0004).
  '''
}

// ═══════════════════════════ RELATIONSHIPS ═══════════════════════════

Ref: user_groups.venue_id > venues.id [delete: restrict]
Ref: user_groups.created_by_user_id > users.id
Ref: user_groups.updated_by_user_id > users.id
Ref: user_group_permissions.group_id > user_groups.id [delete: cascade]
Ref: user_group_permissions.permission_id > permissions.id [delete: cascade]
Ref: user_group_members.group_id > user_groups.id [delete: cascade]
Ref: user_group_members.user_id > users.id [delete: cascade]
Ref: user_group_members.added_by_user_id > users.id
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: user_tokens.user_id > users.id [delete: cascade]

Ref: venues.created_by_user_id > users.id
Ref: venues.updated_by_user_id > users.id
Ref: courts.venue_id > venues.id [delete: restrict]
Ref: courts.created_by_user_id > users.id
Ref: courts.updated_by_user_id > users.id
Ref: price_rules.court_id > courts.id [delete: cascade]
Ref: favorite_venues.user_id > users.id [delete: cascade]
Ref: favorite_venues.venue_id > venues.id [delete: cascade]
Ref: price_rules.created_by_user_id > users.id
Ref: price_rules.updated_by_user_id > users.id

Ref: booking_groups.court_id > courts.id [delete: restrict]
Ref: booking_groups.player_id > users.id [delete: restrict]
Ref: booking_groups.created_by_user_id > users.id
Ref: booking_groups.cancelled_by_user_id > users.id
Ref: booking_slots.booking_group_id > booking_groups.id [delete: cascade]
Ref: booking_slots.court_id > courts.id [delete: restrict]

Ref: booking_groups.checkout_id > checkouts.id [delete: restrict]
